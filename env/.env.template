REVENUE_CAT_ENTITLEMENT_ID=WeeksAlive Pro
REVENUE_CAT_APPLE_API_KEY=
REVENUE_CAT_GOOGLE_API_KEY=

# PostHog — product analytics and session replay.
# POSTHOG_API_KEY is the production project key (Project settings > Project API key).
# Leave POSTHOG_API_KEY_DEV empty to drop all events from debug builds; fill it with the
# key of a separate PostHog project to inspect debug traffic without polluting production.
POSTHOG_API_KEY=
POSTHOG_API_KEY_DEV=
POSTHOG_HOST=https://eu.i.posthog.com

# TikTok Events SDK — validate events before launching campaigns:
# 1. Fill TIKTOK_IOS_ID and TIKTOK_ANDROID_ID from TikTok Events Manager
# 2. Build in debug mode and open Test Events in Events Manager
# 3. Complete a sandbox purchase on a physical device (not iOS Simulator)
# 4. Confirm StartTrial appears in Test Events (Purchase/Subscribe only fire
#    when the offering grants no trial, or the user is no longer eligible)
# TIKTOK_*_APP_ID identifies the app to its store: the numeric App Store id on
# iOS, the package name on Android. TIKTOK_*_ID is the TikTok App ID of the
# matching data source in Events Manager, one per platform.
TIKTOK_IOS_APP_ID=
TIKTOK_IOS_ID=
TIKTOK_ANDROID_APP_ID=com.weeksalive
TIKTOK_ANDROID_ID=
